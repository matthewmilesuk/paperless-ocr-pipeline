# Copy this file to .env and fill in real values. .env is gitignored.

# --- Django ------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC

# --- Redis / Django-RQ ---------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Google Cloud / Document AI -------------------------------------------
# Path INSIDE the container to the service account key JSON. docker-compose.yml
# mounts your host key file to /run/secrets/gcp-credentials.json -- set
# GCP_CREDENTIALS_HOST_PATH below to point at the real file on your machine.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-credentials.json
GCP_CREDENTIALS_HOST_PATH=./gcp-credentials.json

GCP_PROJECT_ID=your-gcp-project-id
GCP_DOCAI_LOCATION=us
# Document AI processor ID for the "Enterprise Document OCR" processor
# (see PROJECT_SPEC.md "OCR - Google Document AI").
GCP_DOCAI_PROCESSOR_ID=your-processor-id

# --- SMTP (job-completion notifications) ----------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM=paperless-ocr-pipeline@example.com
# Address that receives "job complete" notifications.
NOTIFY_EMAIL=you@example.com

# --- Samba (scan-to-folder input / Paperless-NGX-watched output) ---------
SAMBA_USER=scanner
SAMBA_PASSWORD=change-me

# --- Folder paths (inside containers, backed by the scan-data volume) -----
SCAN_INPUT_DIR=/data/input
SCAN_OUTPUT_DIR=/data/output
SCAN_FAILED_DIR=/data/failed

# --- Pipeline tuning (see PROJECT_SPEC.md "Cleanup pass" / "Processing Mode")
BLANK_PAGE_DROP_THRESHOLD_PCT=0.5
BLANK_PAGE_REVIEW_THRESHOLD_PCT=3.0
SYNCHRONOUS_BATCH_SIZE_LIMIT=5

# --- Multi-user / 2FA --------------------------------------------------
# Username of the account watcher-created jobs (Samba drops, no user
# session) are attributed to. Must already exist -- create it first with
# `manage.py createsuperuser` and set up its 2FA device before relying on
# this. See AGENTS.md "Auth & job visibility".
DEFAULT_JOB_OWNER_USERNAME=admin
